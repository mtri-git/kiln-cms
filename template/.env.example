# Node.js and Bun only (Cloudflare reads .dev.vars and wrangler.jsonc). Copy to .env.
NODE_ENV=development
PORT=8787
JWT_SECRET=dev-jwt-secret-change-me-min-32-chars-xxxx
# Origins allowed to call the API from a browser, separated by "|". "*" allows all.
CORS_ALLOW_LIST=*
# SQLite file (libSQL URL). A Turso URL works too, with DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/kiln.db
# Folder of the uploaded files.
FILES_DIR=./data/files
# Public base URL for uploaded files. Empty = serve them through this server at /files/*.
FILES_PUBLIC_URL=
# Behind a proxy that sets the client IP in a header (X-Forwarded-For, X-Real-IP...). Empty = the socket IP.
CLIENT_IP_HEADER=
