{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiln-cms",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No database_id / bucket id on purpose: `wrangler deploy` provisions them on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiln-cms",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kiln-cms"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    // Origins allowed to call the API from a browser, separated by "|". "*" allows all.
    "CORS_ALLOW_LIST": "*",
    // Public base URL for uploaded files (a custom domain on the bucket). Empty = serve through this Worker at /files/*.
    "FILES_PUBLIC_URL": ""
  }
}
