{
  "name": "kiln-cms",
  "version": "0.3.0",
  "description": "A small headless CMS core on Hono and Drizzle (SQLite). Adapters for Cloudflare Workers (D1, R2), Node.js and Bun (SQLite file, local folder).",
  "keywords": [
    "cms",
    "headless-cms",
    "cloudflare",
    "cloudflare-workers",
    "nodejs",
    "bun",
    "hono",
    "drizzle",
    "sqlite",
    "d1",
    "libsql",
    "r2"
  ],
  "license": "MIT",
  "author": "mtri-git (https://github.com/mtri-git)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtri-git/kiln-cms.git",
    "directory": "packages/kiln-cms"
  },
  "homepage": "https://mtri-git.github.io/kiln-cms/",
  "bugs": {
    "url": "https://github.com/mtri-git/kiln-cms/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    }
  },
  "bin": {
    "kiln": "bin/kiln.mjs"
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "reference"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-reference.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.9.30",
    "bcryptjs": "^3.0.2",
    "nanoid": "^5.1.6"
  },
  "peerDependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "zod": "^4.2.1",
    "@hono/node-server": "^2.1.7",
    "@libsql/client": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@hono/node-server": "^2.1.7",
    "@hono/zod-openapi": "^1.2.0",
    "@libsql/client": "^0.18.0",
    "@types/node": "^24.19.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.2.1"
  }
}
