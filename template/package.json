{
  "name": "kiln-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm check:conventions && pnpm test",
    "check:conventions": "kiln check",
    "gen:module": "kiln gen:module",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "kiln-cms": "^0.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
